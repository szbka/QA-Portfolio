-- Завдання 1. Вивести всіх покупців

SELECT *
FROM store.customers;

--Завдання 2. Вивести активні товари

SELECT product_name,
price,
is_active
FROM store.products
WHERE is_active = TRUE;

--Завдання 3. Знайти дорогі товари

SELECT product_id,
product_name,
price
FROM store.products
WHERE price > 10000
ORDER BY price DESC;

--Завдання 4. Знайти покупців з Києва

SELECT customer_id,
full_name,
email,
city
FROM store.customers
WHERE city = 'Київ';

--Завдання 5. Знайти товари за частиною назви

SELECT product_id,
product_name,
price
FROM store.products
WHERE product_name ILIKE 'навушники%';

--Завдання 6. Вивести 5 найдорожчих товарів

SELECT product_name,
price,
FROM store.products
ORDER BY price DESC
LIMIT 5;

--Завдання 7. Порахувати к-сть покупців

SELECT COUNT (customer_id) AS all_customers
FROM store.customers;

--Завдання 8. Знайти середню ціну товарів

SELECT ROUND(AVG(price), 2) AS average_price
FROM store.products;

--Завдання 9. Знайти мінімальну та максимальну ціну

SELECT MIN(price) AS min_price,
MAX(price) AS max_price
FROM store.products;

--Завдання 10. Порахувати товари у кожнай категорії

SELECT 
category_name AS category_name,
COUNT(product_id) AS product_count
FROM store.categories AS c
LEFT JOIN store.products AS p
ON c.category_id = p.category_id
GROUP BY c.category_id, category_name
ORDER BY product_count DESC;

--Завдання 11. Вивести товари разом із категоріями

SELECT product_id,
product_name,
category_name,
price,
stock_quantity
FROM store.products AS p
INNER JOIN store.categories AS c
ON p.category_id = c.category_id
ORDER BY category_name, product_name;

--Завдання 12. Вивести замовлення разом з покупцями

SELECT order_id,
order_date,
status,
full_name,
email,
delivery_city
FROM store.orders AS o
INNER JOIN store.customers AS c
ON o.customer_id = c.customer_id
ORDER BY order_date DESC;

--Завдання 13. Розрахувати суму кожного замовлення

SELECT o.order_id,
c.full_name,
o.status,
SUM(quantity * unit_price)
FROM store.orders AS o
INNER JOIN store.customers AS c
ON o.customer_id = c.customer_id
INNER JOIN store.order_items as i
ON o.order_id = i.order_id
GROUP BY o.order_id,
c.full_name,
o.status;

--Завдання 14. Знайти замовлення дорожчі за 30000 грн

SELECT o.order_id,
c.full_name,
SUM(quantity * unit_price) AS total_amount
FROM store.orders AS o
INNER JOIN store.customers AS c
ON o.customer_id = c.customer_id
INNER JOIN store.order_items AS i
ON o.order_id = i.order_id
GROUP BY o.order_id,
c.full_name
HAVING SUM(quantity * unit_price) > 30000
ORDER BY total_amount DESC;

--Завдання 15. Порахувати к-сть замовлень кожного покупця

SELECT c.full_name,
COUNT(o.order_id) AS total_count
FROM store.customers AS c
LEFT JOIN store.orders AS o
ON c.customer_id = o.customer_id
GROUP BY c.customer_id,
c.full_name;

--Завдання 16. Знайти покупців без замовлень

SELECT c.customer_id,
c.full_name,
c.email
FROM store.customers AS c
LEFT JOIN store.orders AS o
ON c.customer_id = o.customer_id
WHERE o.order_id IS NULL;

--Завдання 17. Знайти товари, що не додавали до замовлень

SELECT p.product_id,
p.product_name,
p.price
FROM store.products AS p
LEFT JOIN store.order_items AS i
ON p.product_id = i.product_id
WHERE i.product_id IS NULL;

--Завдання 18. Знайти товари, яких немає на складі

